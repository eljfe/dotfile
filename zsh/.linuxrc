# this is a child of `/.zshrc`
# linux OS specific settings only

############# PROMPT #############
export RPROMPT='%F{124}%*%f'
hn=$(hostname)
# this line creates a 6 line bottom gutter so you aren't always typing 
# ... in the bottom cm of the screen.  6 newlines, and `/e[6A` apparently
# ... bumps the prompt back up by 6.
# ... fine but IT DOESN'T WORK.  FSR it eats commands.  Try `whoami` or `pwd`
# PS1=$'\n\n\n\n\n\e[6A'
# basic shared prompt
PS1=$'%F{243}%n%f %F{192}%1~%f '
# PS1=$'%F{243}%n@%m%f %F{192}%1~%f '
if [[ $hn == "asus-laptop" ]]; then
    export PS1="$PS1\U1F4A5 "
elif [[ $hn == "sherrysmbp" ]]; then
    export PS1=$PS1"🐌 "
elif [[ $hn == "pihole" ]]; then
    export PS1=$PS1"🥧 "
elif [[ $hn == "obsequious" ]]; then
    export PS1=$PS1"🧅 "
elif [[ $hn == "loiridium" ]]; then
    export PS1=$PS1"🧨 "
elif [[ $hn == "pinkthad" ]]; then
    export PS1="$PS1🌵 "
else
    export PS1="$PS1🌭 "
fi

############# ENV variables #############
export DOTFILES='/srv/dotfile/.config'                                      
export VIMINIT="source $DOTFILES/vim/.vimrc"                                    
export KITTY_CONFIG_DIRECTORY="$DOTFILES/kitty"                                 

localbin="${HOME}/.local/bin"
# localscripts="${localbin}/scripts"
xPATH="usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH="${PATH}:${localbin}:${xPATH}"

gitbin="/usr/bin/git" 

# CMDSTAN_HOME="$HOME/.stan/cmdstan"
# JULIA_CMDSTAN_HOME="$HOME/.stan/cmdstan"

# this PYTHONPATH setting requires `:` path seperators
PYTHONPATH="${HOME}/.local/lib/python-3x/site-packages:"
PYTHONPATH="${PYTHONPATH}:${DOTFILES}/../.local/lib/python-3x/site-packages"
export PYTHONPATH

# KITTYPATH="/Applications/kitty.app/Contents/MacOS/kitty"
FINDATA_PATH="/srv/financials"
export FINDATA_PATH
# export CMDSTAN_HOME
# export JULIA_CMDSTAN_HOME

############# ALIAS's #############
# battery percent
set -o PROMPT_SUBST
batt () {
    echo $(cat /sys/class/power_supply/BAT0/capacity)%
}

round () { echo $(( ($1 + $2/2) / $2 )) }
roundf () { printf "%.${2:-0}f" "$1" }

# core temp on systems that don't ship with lm_sensor
ctemp () {
	systemp=$(cat /sys/class/thermal/thermal_zone0/temp)
	t=$(( $systemp/1000.0 ))
    echo "$(roundf $t 2)"
}

# acpi | awk -F, '{print $2}' | sed 's/^ //'
# export RPROMPT="%F{124}%*/$(bat)%%"

# 'bat' is a cat alternative 
# 'bat' has a namespace conflict with another Debain package hence alias
distro=$(grep '^ID=' /etc/os-release | cut -d '=' -f 2 | tr -d '"')
if [ $distro = debian ]; then
	alias bat='batcat'
fi

if [ $(hostname) = obsequious ]; then
	source $DOTFILES/zsh/.obsequious
elif [ $(hostname) = loiridium ]; then
	source $DOTFILES/zsh/.loiridium
elif [ $(hostname) = pinkthad ]; then
	source ${DOTFILES}/zsh/.pinkthad
fi


alias l1='ls -A1 --color'
alias ll='ls -lAFh --color'
alias vz="vim $ZDOTDIR/.zshrc"
alias sz="source $ZDOTDIR/.zshrc"
alias vv="vim $DOTFILES/vim/.vimrc"
# alias scanlocal="nmap -sn 192.168.2.0/24"
alias ttc='xclip -selection clipboard'  # to the clipboard
alias vpn-up="sudo wg-quick up wg0"
alias vpn-dn="sudo wg-quick down wg0"
alias vpn-stat="sudo wg show wg0"

# --- trash-cli ---
alias del='trash-put'           	# move to trash (don't alias rm!)
alias tr='trash-put'            	# short form
alias undelete='trash-restore'  	# interactive restore
alias trashlist='trash-list'    	# list your trashed files
alias untrash='trash-rm'        	# delete one item from trash for good
alias empty-trash='trash-empty' 	# empty your trash
alias trashlist-all='sudo trash-list --all-users'
alias trash-empty-all='sudo trash-empty --all-users'
