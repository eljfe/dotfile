# this is a child of `/.zshrc`
# macOS specific settings only


############# PROMPT #############
hn=$(hostname)
# this line creates a 6 line bottom gutter so you aren't always typing 
# ... in the bottom cm of the screen.  6 newlines, and `/e[6A` apparently
# ... bumps the prompt back up by 6.
# ... fine but IT DOESN'T WORK.  FSR it eats commands.  Try `whoami` or `pwd`
# PS1=$'\n\n\n\n\n\e[6A'
# basic shared prompt
PS1=$'%F{243}%n%f %F{192}%1~%f '
# PS1=$'%F{243}%n@%m%f %F{192}%1~%f '
if [[ $hn =~ ".*mothership.*" ]]; then
	  export PS1=$PS1"🌲 "
else
    export PS1="$PS1🌭 "
fi

############# ENV variables #############
export DOTFILES='/Users/Shared/config'                                      
export VIMINIT="source $DOTFILES/vim/.vimrc"                                    
export KITTY_CONFIG_DIRECTORY="$DOTFILES/kitty"                                 


gitbin="/usr/local/bin/git" 

pybin="/usr/local/lib/python3.11"
localbin="${HOME}/.local/bin"
# localscripts="${localbin}/scripts"
export PATH="${PATH}:${pybin}:${localbin}"

# this PYTHONPATH setting requires `:` path seperators
PYTHONPATH="${HOME}/.local/lib/python-3x/site-packages:"
PYTHONPATH="${PYTHONPATH}:${DOTFILES}/../.local/lib/python-3x/site-packages"
export PYTHONPATH

# KITTYPATH="/Applications/kitty.app/Contents/MacOS/kitty"
BUDGET_PATH="$HOME/Documents/Business/Financials/Budget"
PCFIN_PATH="$HOME/Documents/Business/Financials/PCFin"
FINDATA_PATH="/Users/Shared/Financials"
LATEXPATH="/Library/TeX/texbin"
# CMDSTAN_HOME="$HOME/.stan/cmdstan"
PYLOCAL="/Users/Shared/.local/lib/python-3x/site-packages"
# JULIA_CMDSTAN_HOME="$HOME/.stan/cmdstan"

export FINDATA_PATH
export PYLOCAL
# export CMDSTAN_HOME
# export JULIA_CMDSTAN_HOME

xPATH="usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
xPATH="${xPATH}:/Library/Apple/usr/bin:$HOME/Library/Python/3.11/bin:"
xPATH="${xPATH}:$HOME/Library/Python/3.10/bin:$LATEXPATH"
PATH="${PATH}:${xPATH}"
export PATH

#
############# ALIAS's #############
git-python-utils() { 
	ggit --git-dir="${HOME}/.local/lib/.git/" \
		--work-tree="$HOME/.local/lib/" "$@" ; 
}

# kitty specific 
if [[ -n $TERM && "xterm-kitty" == $TERM  ]]; then
  alias ssh="kitty +kitten ssh"
fi

# battery percent
set -o PROMPT_SUBST
batt () {
    echo $(cat /sys/class/power_supply/BAT0/capacity)%
}

round () { echo $(( ($1 + $2/2) / $2 )) }
roundf () { printf "%.${2:-0}f" "$1" }

alias ll='ls -lAFh --color'
alias vz="vim $ZDOTDIR/.zshrc"
alias sz="source $ZDOTDIR/.zshrc"
alias vv="vim $DOTFILES/vim/.vimrc"
alias pingpi="ping 192.168.2.200"
alias sshpi="ssh pi@pihole.local"
alias sshob="ssh eljfe@obsequious.local" 	# obsequious.local breaks
alias scanlocal="nmap -sn 192.168.2.0/24"


